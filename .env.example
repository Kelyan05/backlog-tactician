STEAM_API_KEY=
STEAM_ID=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
DATABASE_URL=
SESSION_SECRET=

# In production the API serves the built frontend itself (see Dockerfile),
# so both of these should be your one public URL, e.g. https://your-app.example.com
# — APP_BASE_URL also doubles as the Steam OpenID "realm", so it must exactly
# match the domain Steam redirects back to.
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Optional. Error monitoring stays fully inert (no Sentry.init() call at all)
# until this is set — leave it blank unless you have a Sentry project.
SENTRY_DSN=